    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>test0</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>rst C start done hs last w15   st_idle st_gen st_xor

# reset
1   C   0     0    0  0    0     1       0      0
# IDLE waits for start, ignores other inputs
0   C   0     0    0  0    0     1       0      0
0   C   0     1    1  1    1     1       0      0
# IDLE -&gt; GEN
0   C   1     0    0  0    0     0       1      0
# GEN waits for done
0   C   0     0    0  0    0     0       1      0
0   C   0     0    1  1    1     0       1      0
# GEN -&gt; XOR
0   C   0     1    0  0    0     0       0      1
# XOR: no handshake, stay
0   C   0     0    0  0    0     0       0      1
# XOR: handshake, word &lt; 15, stay
0   C   0     0    1  0    0     0       0      1
# XOR: handshake on word 15 -&gt; GEN (next block)
0   C   0     0    1  0    1     0       1      0
# GEN -&gt; XOR
0   C   0     1    0  0    0     0       0      1
# XOR: last word -&gt; IDLE
0   C   0     0    1  1    0     1       0      0

# last has priority over w15
0   C   1     0    0  0    0     0       1      0
0   C   0     1    0  0    0     0       0      1
0   C   0     0    1  1    1     1       0      0

# last without handshake does nothing
0   C   1     0    0  0    0     0       1      0
0   C   0     1    0  0    0     0       0      1
0   C   0     0    0  1    1     0       0      1

# back to IDLE
1   C   0     0    0  0    0     1       0      0
# GEN: done together with the last word -&gt; IDLE (one-word message)
0   C   1     0    0  0    0     0       1      0
0   C   0     1    1  1    0     1       0      0
# GEN: done together with a word that is not the last -&gt; XOR
0   C   1     0    0  0    0     0       1      0
0   C   0     1    1  0    0     0       0      1
# GEN: done, last but no handshake -&gt; XOR
0   C   0     0    1  1    0     1       0      0
0   C   1     0    0  0    0     0       1      0
0   C   0     1    0  1    0     0       0      1

# reset from XOR
1   C   0     0    0  0    0     1       0      0</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="400" y="-160"/>
    </visualElement>
